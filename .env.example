# Vorlage. In Coolify als Env-Variablen setzen, diese Datei nie mit echten
# Werten committen (.env steht in .gitignore).

# openai oder anthropic
KI_ANBIETER=openai

# Provider-Schluessel, je nach Anbieter einer davon
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# optional, sonst Standardmodell
KI_MODELL=gpt-5.6-terra

# finale Domain, fuer Origin-Check und CSP
ALLOWED_ORIGIN=https://lpp-sports.de

# Captcha-Signatur, erzeugen mit: openssl rand -hex 32
CAPTCHA_HMAC_KEY=

# optional, Standard 3000
PORT=3000

# Anzahl vertrauenswuerdiger Proxy-Hops fuer die echte Client-IP.
# Coolify/Traefik = 1 (Standard). 0 = kein Proxy, X-Forwarded-For ignorieren.
TRUSTED_PROXY_HOPS=1

# optionaler seitenweiter Schutz fuer den privaten Prototyp.
# Beide setzen, um Basic Auth zu aktivieren, beide leer lassen, um sie auszuschalten.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- Mailversand (Resend), siehe docs/adr/0002-mailversand-resend.md ---
# Ohne Key laeuft /api/lead lokal im Testmodus (keine Mail), in Produktion liefert es 503.
RESEND_API_KEY=
# Absender auf einer in Resend verifizierten Domain
MAIL_FROM=LPP Sports <hallo@lpp-sports.de>
# optional: Archivkopie jeder Guides-Mail
MAIL_BCC=
# Ordner mit guide-3-wie-ich-trainieren-sollte.pdf. Das Repo ist oeffentlich, Guide 3
# darf nicht committet werden. In Coolify als Persistent Storage mounten (z. B. /data/pdfs).
# Standard: ./private-pdfs
PDF_DIR=
