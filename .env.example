# Vorlage. In Coolify als Env-Variablen setzen, diese Datei nie mit echten
# Werten committen (.env steht in .gitignore).

# openai oder anthropic
KI_ANBIETER=openai

# Provider-Schluessel, je nach Anbieter einer davon
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# optional, sonst Standardmodell
KI_MODELL=gpt-5.6-terra

# finale Domain, fuer Origin-Check und CSP
ALLOWED_ORIGIN=https://lpp-sports.de

# Captcha-Signatur, erzeugen mit: openssl rand -hex 32
CAPTCHA_HMAC_KEY=

# optional, Standard 3000
PORT=3000

# optionaler seitenweiter Schutz fuer den privaten Prototyp.
# Beide setzen, um Basic Auth zu aktivieren, beide leer lassen, um sie auszuschalten.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
